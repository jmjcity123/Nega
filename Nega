local espCache = {}
local SKELETON_LINE_COUNT = 14

local function hidePlayerEsp(cache)
    cache.Box.Visible = false
    cache.Name.Visible = false
    cache.Distance.Visible = false
    cache.Snapline.Visible = false
    cache.HeadCircle.Visible = false
    for _, line in ipairs(cache.SkeletonLines) do
        line.Visible = false
    end
end

local function removeEspForPlayer(p)
    if espCache[p] then
        pcall(function()
            espCache[p].Box:Remove()
            espCache[p].Name:Remove()
            espCache[p].Distance:Remove()
            espCache[p].Snapline:Remove()
            espCache[p].HeadCircle:Remove()
            for _, line in ipairs(espCache[p].SkeletonLines) do
                line:Remove()
            end
        end)
        espCache[p] = nil
    end
end

Players.PlayerRemoving:Connect(removeEspForPlayer)

RunService.RenderStepped:Connect(function()
    local vpSize = Camera.ViewportSize
    local camPos = Camera.CFrame.Position
    local anyEspActive = (espBox or espSnaplines or espNames or espDistance or espSkeleton)

    for p, cache in pairs(espCache) do
        if not p.Parent or not anyEspActive then
            hidePlayerEsp(cache)
        end
    end

    if not anyEspActive then return end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if char and hum and hrp and hum.Health > 0 then
                if not espCache[p] then
                    local skelLines = {}
                    for i = 1, SKELETON_LINE_COUNT do
                        local l = Drawing.new("Line")
                        l.Thickness = 1.3
                        table.insert(skelLines, l)
                    end

                    espCache[p] = {
                        Box = Drawing.new("Square"),
                        Name = Drawing.new("Text"),
                        Distance = Drawing.new("Text"),
                        Snapline = Drawing.new("Line"),
                        HeadCircle = Drawing.new("Circle"),
                        SkeletonLines = skelLines
                    }
                    espCache[p].Box.Thickness = 1.4
                    espCache[p].Box.Filled = false
                    espCache[p].Name.Size = 13
                    espCache[p].Name.Center = true
                    espCache[p].Name.Outline = true
                    espCache[p].Distance.Size = 11
                    espCache[p].Distance.Center = true
                    espCache[p].Distance.Outline = true
                    espCache[p].Snapline.Thickness = 1.5
                    
                    espCache[p].HeadCircle.Thickness = 1.3
                    espCache[p].HeadCircle.Filled = false
                    espCache[p].HeadCircle.NumSides = 18
                end

                local cache = espCache[p]
                local rootPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                if onScreen then
                    local topPart = char:FindFirstChild("Head") or hrp
                    local bottomPart = char:FindFirstChild("LeftFoot") or char:FindFirstChild("RightFoot") or char:FindFirstChild("Left Leg") or hrp

                    local topPos = Camera:WorldToViewportPoint(topPart.Position + Vector3.new(0, 1.1, 0))
                    local botPos = Camera:WorldToViewportPoint(bottomPart.Position - Vector3.new(0, 1.1, 0))

                    local height = math.abs(topPos.Y - botPos.Y)
                    local width = height * 0.65

                    if espBox then
                        cache.Box.Visible = true
                        cache.Box.Size = Vector2.new(width, height)
                        cache.Box.Position = Vector2.new(rootPos.X - width / 2, topPos.Y)
                        cache.Box.Color = currentThemeColor
                    else
                        cache.Box.Visible = false
                    end

                    if espNames then
                        cache.Name.Visible = true
                        cache.Name.Text = p.Name
                        cache.Name.Position = Vector2.new(rootPos.X, topPos.Y - 16)
                        cache.Name.Color = currentThemeColor
                    else
                        cache.Name.Visible = false
                    end

                    if espDistance then
                        local dist = (camPos - hrp.Position).Magnitude
                        cache.Distance.Visible = true
                        cache.Distance.Text = math.floor(dist) .. "m"
                        cache.Distance.Position = Vector2.new(rootPos.X, topPos.Y - 28)
                        cache.Distance.Color = currentThemeColor
                    else
                        cache.Distance.Visible = false
                    end

                    if espSnaplines then
                        cache.Snapline.Visible = true
                        cache.Snapline.From = Vector2.new(vpSize.X / 2, 0)
                        cache.Snapline.To = Vector2.new(rootPos.X, topPos.Y)
                        cache.Snapline.Color = currentThemeColor
                    else
                        cache.Snapline.Visible = false
                    end

                    if espSkeleton then
                        local positions = {}
                        
                        if char:FindFirstChild("UpperTorso") then
                            local function getPos(name) local part = char:FindFirstChild(name) return part and part.Position end
                            positions = {
                                Head = getPos("Head"), Neck = getPos("UpperTorso"), Pelvis = getPos("LowerTorso"),
                                LShoulder = getPos("LeftUpperArm"), LElbow = getPos("LeftLowerArm"), LHand = getPos("LeftHand"),
                                RShoulder = getPos("RightUpperArm"), RElbow = getPos("RightLowerArm"), RHand = getPos("RightHand"),
                                LHip = getPos("LeftUpperLeg"), LKnee = getPos("LeftLowerLeg"), LFoot = getPos("LeftFoot"),
                                RHip = getPos("RightUpperLeg"), RKnee = getPos("RightLowerLeg"), RFoot = getPos("RightFoot")
                            }
                        elseif char:FindFirstChild("Torso") then
                            local t = char:FindFirstChild("Torso")
                            local la = char:FindFirstChild("Left Arm")
                            local ra = char:FindFirstChild("Right Arm")
                            local ll = char:FindFirstChild("Left Leg")
                            local rl = char:FindFirstChild("Right Leg")
                            local h = char:FindFirstChild("Head")

                            positions.Head = h and h.Position
                            if t then
                                positions.Neck = (t.CFrame * CFrame.new(0, 0.8, 0)).Position
                                positions.Pelvis = (t.CFrame * CFrame.new(0, -0.8, 0)).Position
                            end
                            if la then
                                positions.LShoulder = (la.CFrame * CFrame.new(0, 0.8, 0)).Position
                                positions.LElbow = la.Position
                                positions.LHand = (la.CFrame * CFrame.new(0, -0.8, 0)).Position
                            end
                            if ra then
                                positions.RShoulder = (ra.CFrame * CFrame.new(0, 0.8, 0)).Position
                                positions.RElbow = ra.Position
                                positions.RHand = (ra.CFrame * CFrame.new(0, -0.8, 0)).Position
                            end
                            if ll then
                                positions.LHip = (ll.CFrame * CFrame.new(0, 0.8, 0)).Position
                                positions.LKnee = ll.Position
                                positions.LFoot = (ll.CFrame * CFrame.new(0, -0.8, 0)).Position
                            end
                            if rl then
                                positions.RHip = (rl.CFrame * CFrame.new(0, 0.8, 0)).Position
                                positions.RKnee = rl.Position
                                positions.RFoot = (rl.CFrame * CFrame.new(0, -0.8, 0)).Position
                            end
                        end

                        if positions.Head then
                            local headPos, headOnScreen = Camera:WorldToViewportPoint(positions.Head)
                            local headTopPos = Camera:WorldToViewportPoint(positions.Head + Vector3.new(0, 0.45, 0))
                            
                            if headOnScreen then
                                local dynamicRadius = (Vector2.new(headPos.X, headPos.Y) - Vector2.new(headTopPos.X, headTopPos.Y)).Magnitude
                                cache.HeadCircle.Visible = true
                                cache.HeadCircle.Position = Vector2.new(headPos.X, headPos.Y)
                                cache.HeadCircle.Color = currentThemeColor
                                cache.HeadCircle.Radius = math.clamp(dynamicRadius, 1.5, 60)
                            else
                                cache.HeadCircle.Visible = false
                            end
                        else
                            cache.HeadCircle.Visible = false
                        end

                        local connectionMap = {
                            {"Head", "Neck"}, {"Neck", "Pelvis"},
                            {"Neck", "LShoulder"}, {"LShoulder", "LElbow"}, {"LElbow", "LHand"},
                            {"Neck", "RShoulder"}, {"RShoulder", "RElbow"}, {"RElbow", "RHand"},
                            {"Pelvis", "LHip"}, {"LHip", "LKnee"}, {"LKnee", "LFoot"},
                            {"Pelvis", "RHip"}, {"RHip", "RKnee"}, {"RKnee", "RFoot"}
                        }

                        for idx, lineObj in ipairs(cache.SkeletonLines) do
                            local conn = connectionMap[idx]
                            if conn and positions[conn[1]] and positions[conn[2]] then
                                local posA, onA = Camera:WorldToViewportPoint(positions[conn[1]])
                                local posB, onB = Camera:WorldToViewportPoint(positions[conn[2]])
                                
                                if onA or onB then
                                    lineObj.Visible = true
                                    lineObj.From = Vector2.new(posA.X, posA.Y)
                                    lineObj.To = Vector2.new(posB.X, posB.Y)
                                    lineObj.Color = currentThemeColor
                                else
                                    lineObj.Visible = false
                                end
                            else
                                lineObj.Visible = false
                            end
                        end
                    else
                        cache.HeadCircle.Visible = false
                        for _, lineObj in ipairs(cache.SkeletonLines) do
                            lineObj.Visible = false
                        end
                    end

                else
                    hidePlayerEsp(cache)
                end
            else
                if espCache[p] then
                    hidePlayerEsp(espCache[p])
                end
            end
        end
    end
end)

