local aimbotPCEnabled = false
local aimbotMobileEnabled = false
local aimFOV = 130

local fovCircle = Drawing.new("Circle")
fovCircle.Visible = false
fovCircle.Radius = aimFOV
fovCircle.Filled = false
fovCircle.Thickness = 1.2
fovCircle.Color = Color3.fromRGB(220, 120, 240)

local function updateFovVisibility()
    fovCircle.Visible = aimbotPCEnabled or aimbotMobileEnabled
end

createToggle(tabs["Aimbot"], "Aimbot PC", 0, function(state)
    aimbotPCEnabled = state
    updateFovVisibility()
end)

createToggle(tabs["Aimbot"], "Aimbot Mobile", 45, function(state)
    aimbotMobileEnabled = state
    updateFovVisibility()
end)

createSlider(tabs["Aimbot"], "FOV Größe", 90, 30, 500, aimFOV, function(val)
    aimFOV = val
    fovCircle.Radius = val
end)

local function getClosestPlayerInFOV()
    local closestTarget = nil
    local shortestFovDist = aimFOV
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChildOfClass("Humanoid") then
            if p.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                local head = p.Character.Head
                local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
                
                if onScreen then
                    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local fovDist = (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude
                    
                    if fovDist < shortestFovDist then
                        shortestFovDist = fovDist
                        closestTarget = head
                    end
                end
            end
        end
    end
    return closestTarget
end

local lockedTarget = nil

RunService.RenderStepped:Connect(function()
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    fovCircle.Position = screenCenter
    
    if not aimbotPCEnabled and not aimbotMobileEnabled then return end
    
    if aimbotPCEnabled then
        local rmbHeld = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        if rmbHeld then
            if not lockedTarget or not lockedTarget.Parent or not lockedTarget.Parent:FindFirstChildOfClass("Humanoid") or lockedTarget.Parent:FindFirstChildOfClass("Humanoid").Health <= 0 then
                lockedTarget = getClosestPlayerInFOV()
            end
            if lockedTarget then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, lockedTarget.Position)
                return
            end
        else
            lockedTarget = nil
        end
    end

    if aimbotMobileEnabled then
        local target = getClosestPlayerInFOV()
        if target then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
        end
    end
end)

